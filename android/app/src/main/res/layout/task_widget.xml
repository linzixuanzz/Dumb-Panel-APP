<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件布局（RemoteViews 只认 LinearLayout / TextView 这类基础控件）。
     颜色全部引用 @color/widget_*：浅色在 values/colors.xml，深色在 values-night/colors.xml，跟随系统。
     根节点用 @android:id/background：安卓 12+ 启动器据此按系统圆角裁切。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 第一行：今日成功率（点按 → 概览） -->
    <LinearLayout
        android:id="@+id/widget_rate_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日成功率"
                android:textColor="@color/widget_text2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/widget_text"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打开 APP 获取数据"
                android:textColor="@color/widget_text2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_rate_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/widget_text2"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第二行：下一个任务（点按 → 该任务详情） -->
    <LinearLayout
        android:id="@+id/widget_next_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下一个"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="暂无"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_text2"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 第三行：最近失败的任务（点按 → 该任务详情） -->
    <LinearLayout
        android:id="@+id/widget_failed_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/widget_failed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近失败"
            android:textColor="@color/widget_err"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_failed_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="暂无"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_failed_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_text2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
